
OUTPUT_FORMAT(elf64-x86-64)
ENTRY(_start)

SECTIONS
{
    . = 0xffffffff80000000;

    .text : { *(.text .text.*) }

    . = ALIGN(4K);
    .rodata : { *(.rodata .rodata.*) }

    . = ALIGN(4K);
    .data : {
        *(.data .data.*)
        *(.limine_requests)
    }

    . = ALIGN(4K);
    .bss : { *(.bss .bss.*) *(COMMON) }

    /DISCARD/ : { *(.eh_frame*) *(.note .note.*) *(.comment) }
}
